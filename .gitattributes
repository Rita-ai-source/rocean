# Normalize line endings to LF (Unix) for HTML/CSS files.
# This prevents huge diffs when editors switch between CRLF and LF.
# Browsers don't care about line endings, so this is purely a dev-quality issue.

*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.json    text eol=lf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.svg     text
*.webp    binary